{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repatria-europe",
  "compatibility_date": "2026-09-09",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
